{
  "$defs": {
    "Agent": {
      "properties": {
        "agentSession": {
          "type": "string"
        },
        "cwd": {
          "description": "Where the agent session started; `claude --resume` finds it only there.",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "lastError": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the last turn failed; cleared by the next prompt. Only hooks report it."
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "description": "The session the agent runs in; `null` once that session is closed.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "tracking": {
          "$ref": "#/$defs/Tracking"
        }
      },
      "required": [
        "kind",
        "agentSession",
        "cwd",
        "state",
        "tracking"
      ],
      "type": "object"
    },
    "AgentError": {
      "description": "A turn that ended on an API error (Claude Code's `StopFailure`).",
      "properties": {
        "error": {
          "description": "Claude Code's error type, such as `rate_limit` or `authentication_failed`.",
          "type": "string"
        },
        "message": {
          "description": "What the agent showed the user, when it said.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "AgentKindStatus": {
      "description": "Whether an agent terminal of `kind` can be launched on this host, and\nwhy not; also the `agent.kind.changed` event.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "available"
      ],
      "type": "object"
    },
    "AgentListResult": {
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/Agent"
          },
          "type": "array"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/AgentKindStatus"
          },
          "type": "array"
        }
      },
      "required": [
        "kinds",
        "agents"
      ],
      "type": "object"
    },
    "AgentRef": {
      "description": "Names one agent: the `agent.removed` event.",
      "properties": {
        "agentSession": {
          "type": "string"
        }
      },
      "required": [
        "agentSession"
      ],
      "type": "object"
    },
    "AgentResult": {
      "description": "The `agent.changed` event.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentState": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "idle",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A turn is running.",
          "properties": {
            "kind": {
              "const": "busy",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "waiting",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/WaitingReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The agent was launched resuming it; no `SessionStart` has arrived yet.",
          "properties": {
            "kind": {
              "const": "resuming",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Any state this build does not know, from a newer peer.",
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "AttachmentAckParams": {
      "description": "The client notification `session.attachment.ack`: `bytes` is the\ncumulative count of SNAPSHOT and OUTPUT data the client has drawn on this\nattachment. The daemon keeps at most 128 KiB unacknowledged.",
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "attachment",
        "bytes"
      ],
      "type": "object"
    },
    "AttachmentError": {
      "description": "The event `session.attachment.error`: INPUT frames have no reply, so\ntheir errors come back here.",
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "attachment",
        "code",
        "message"
      ],
      "type": "object"
    },
    "AttachmentOpenParams": {
      "description": "`session.attachment.open`: the reply comes first, then exactly one\nSNAPSHOT frame, then OUTPUT frames from the snapshot's offset.",
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "ignoreSize": {
          "description": "It never sets the session's size, even when it is the latest active.",
          "type": "boolean"
        },
        "readOnly": {
          "description": "Its INPUT gets `READ_ONLY` instead of reaching the shell.",
          "type": "boolean"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "AttachmentOpenResult": {
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/Session"
        }
      },
      "required": [
        "attachment",
        "session"
      ],
      "type": "object"
    },
    "AttachmentRef": {
      "description": "Names one attachment: the params of `session.attachment.close`.",
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "attachment"
      ],
      "type": "object"
    },
    "AttachmentResizeParams": {
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "attachment",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "Capability": {
      "description": "One module of the daemon and whether this host can serve it; `reason`\nnames the fix when it cannot.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "info": true,
        "module": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "module",
        "available"
      ],
      "type": "object"
    },
    "ClientInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "via": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "DaemonInfo": {
      "description": "`instance` is random per daemon process, so a reconnecting client can\ntell a dropped connection from a restarted daemon.",
      "properties": {
        "instance": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "instance"
      ],
      "type": "object"
    },
    "DaemonShutdownParams": {
      "description": "`restore: false` hangs up every session and forgets it; `true` leaves\nthem for the next daemon instance to restore (ADR 0027).",
      "properties": {
        "restore": {
          "type": "boolean"
        }
      },
      "required": [
        "restore"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "oneOf": [
        {
          "enum": [
            "MODULE_UNAVAILABLE",
            "UNKNOWN_SESSION"
          ],
          "type": "string"
        },
        {
          "const": "HELLO_REQUIRED",
          "description": "The first request on a connection was not `hello`.",
          "type": "string"
        },
        {
          "const": "HELLO_REPEATED",
          "description": "`hello` was already answered on this connection.",
          "type": "string"
        },
        {
          "const": "VERSION_MISMATCH",
          "description": "No protocol version both ends speak; `detail` carries the daemon's range.",
          "type": "string"
        },
        {
          "const": "UNKNOWN_ATTACHMENT",
          "description": "No such attachment on this connection.",
          "type": "string"
        },
        {
          "const": "READ_ONLY",
          "description": "Input on an attachment opened `readOnly`.",
          "type": "string"
        },
        {
          "const": "SESSION_EXITED",
          "description": "Input to a session whose shell has exited.",
          "type": "string"
        },
        {
          "const": "ROOT_GONE",
          "description": "The session root no longer exists.",
          "type": "string"
        },
        {
          "const": "NOT_FOUND",
          "description": "A path the request names does not exist.",
          "type": "string"
        },
        {
          "const": "AGENT_LIVE",
          "description": "`session.open { resume }` names an agent session already running or\nresuming in another session.",
          "type": "string"
        },
        {
          "const": "UNKNOWN",
          "description": "Any code this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "ErrorData": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "detail": true
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "HelloParams": {
      "description": "`protocolVersion` is the newest version the client speaks,\n`minProtocolVersion` the oldest.",
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "minProtocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocolVersion",
        "minProtocolVersion",
        "client"
      ],
      "type": "object"
    },
    "HelloResult": {
      "description": "`protocolVersion` is the version both ends speak from here on.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        },
        "daemon": {
          "$ref": "#/$defs/DaemonInfo"
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocolVersion",
        "daemon",
        "capabilities"
      ],
      "type": "object"
    },
    "Id": {
      "anyOf": [
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "Notification": {
      "properties": {
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "Request": {
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "type": "object"
    },
    "Response": {
      "description": "`id` is `null` only when the request it answers could not be read.",
      "oneOf": [
        {
          "properties": {
            "result": true
          },
          "required": [
            "result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "$ref": "#/$defs/RpcError"
            }
          },
          "required": [
            "error"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "type": "string"
        }
      },
      "required": [
        "jsonrpc"
      ],
      "type": "object"
    },
    "RpcError": {
      "description": "A JSON-RPC error. Protocol errors use [`RpcError::SERVER_ERROR`] and name\nthemselves in `data.code`; the numeric codes stay JSON-RPC's own.",
      "properties": {
        "code": {
          "format": "int32",
          "type": "integer"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorData"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Session": {
      "properties": {
        "attachments": {
          "description": "How many attachments the session has, across all clients.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "foreground": {
          "description": "The name of the terminal's foreground process: the shell when idle,\nabsent while no shell runs.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "description": "The user's name for the session, set by `session.rename`.",
          "type": [
            "string",
            "null"
          ]
        },
        "plane": {
          "description": "Opaque to the daemon: stored, exported as `BITPLANE_PLANE_ID`, returned.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "description": "The session root: the directory the shell starts in.",
          "type": "string"
        },
        "rootGone": {
          "default": false,
          "description": "The root no longer exists; a running shell keeps running, and\n`session.restart` gets `ROOT_GONE` until it is back.",
          "type": "boolean"
        },
        "seq": {
          "description": "Creation order on this host.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "title": {
          "description": "The title the program set (OSC 0/2), kept apart from `name`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "seq",
        "root",
        "status",
        "size",
        "attachments"
      ],
      "type": "object"
    },
    "SessionBusyResult": {
      "description": "The result of `session.busy`: busy when the terminal's foreground process\nis not the shell, and then that process's name.",
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "processName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "busy"
      ],
      "type": "object"
    },
    "SessionListResult": {
      "properties": {
        "sessions": {
          "items": {
            "$ref": "#/$defs/Session"
          },
          "type": "array"
        }
      },
      "required": [
        "sessions"
      ],
      "type": "object"
    },
    "SessionOpenParams": {
      "description": "`session.open`: `root` must be an existing directory. `env` is set on top\nof the daemon's login-shell environment. `resume` types the agent's resume\nline into the new shell; an agent session live elsewhere gets `AGENT_LIVE`.",
      "properties": {
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "plane": {
          "type": [
            "string",
            "null"
          ]
        },
        "resume": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "SessionRef": {
      "description": "Names one session: the params of `session.close`, `session.restart` and\n`session.busy`, and the `session.removed` event.",
      "properties": {
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ],
      "type": "object"
    },
    "SessionRenameParams": {
      "description": "`session.rename`: no `name` clears it. Replies with [`SessionResult`].",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ],
      "type": "object"
    },
    "SessionResult": {
      "description": "The result of `session.open`, and the `session.changed` event.",
      "properties": {
        "session": {
          "$ref": "#/$defs/Session"
        }
      },
      "required": [
        "session"
      ],
      "type": "object"
    },
    "SessionStatus": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "running",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "format": "int32",
              "type": "integer"
            },
            "state": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "state",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The shell could not be started.",
          "properties": {
            "error": {
              "type": "string"
            },
            "state": {
              "const": "spawnFailed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "error"
          ],
          "type": "object"
        },
        {
          "description": "Any state this build does not know, from a newer peer.",
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Size": {
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "Tracking": {
      "description": "Where the agent's state comes from: its hooks, or only the polled\n`claude agents --json` registry when the hooks did not load.",
      "oneOf": [
        {
          "enum": [
            "hooks",
            "poll"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Any mode this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "WaitingReason": {
      "oneOf": [
        {
          "enum": [
            "permission",
            "input",
            "other"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Any reason this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bitplane protocol"
}
