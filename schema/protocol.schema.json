{
  "$defs": {
    "Agent": {
      "properties": {
        "agentSession": {
          "type": "string"
        },
        "cwd": {
          "description": "Where the agent session started; `claude --resume` finds it only there.",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "lastError": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the last turn failed; cleared by the next prompt. Only hooks report it."
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "description": "The session the agent runs in; `null` once that session is closed.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "tracking": {
          "$ref": "#/$defs/Tracking"
        }
      },
      "required": [
        "kind",
        "agentSession",
        "cwd",
        "state",
        "tracking"
      ],
      "type": "object"
    },
    "AgentError": {
      "description": "A turn that ended on an API error (Claude Code's `StopFailure`).",
      "properties": {
        "error": {
          "description": "Claude Code's error type, such as `rate_limit` or `authentication_failed`.",
          "type": "string"
        },
        "message": {
          "description": "What the agent showed the user, when it said.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "AgentKindStatus": {
      "description": "Whether an agent terminal of `kind` can be launched on this host, and\nwhy not; also the `agent.kind.changed` event.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "available"
      ],
      "type": "object"
    },
    "AgentListResult": {
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/Agent"
          },
          "type": "array"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/AgentKindStatus"
          },
          "type": "array"
        }
      },
      "required": [
        "kinds",
        "agents"
      ],
      "type": "object"
    },
    "AgentRef": {
      "description": "Names one agent: the `agent.removed` event.",
      "properties": {
        "agentSession": {
          "type": "string"
        }
      },
      "required": [
        "agentSession"
      ],
      "type": "object"
    },
    "AgentResult": {
      "description": "The `agent.changed` event.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentState": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "idle",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A turn is running.",
          "properties": {
            "kind": {
              "const": "busy",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "waiting",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/WaitingReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The agent was launched resuming it; no `SessionStart` has arrived yet.",
          "properties": {
            "kind": {
              "const": "resuming",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Any state this build does not know, from a newer peer.",
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "AttachmentAckParams": {
      "description": "The client notification `session.attachment.ack`: `bytes` is the\ncumulative count of SNAPSHOT and OUTPUT data the client has drawn on this\nattachment. The daemon keeps at most 128 KiB unacknowledged.",
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "attachment",
        "bytes"
      ],
      "type": "object"
    },
    "AttachmentError": {
      "description": "The event `session.attachment.error`: INPUT frames have no reply, so\ntheir errors come back here.",
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "attachment",
        "code",
        "message"
      ],
      "type": "object"
    },
    "AttachmentOpenParams": {
      "description": "`session.attachment.open`: the reply comes first, then exactly one\nSNAPSHOT frame, then OUTPUT frames from the snapshot's offset.",
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "ignoreSize": {
          "description": "It never sets the session's size, even when it is the latest active.",
          "type": "boolean"
        },
        "readOnly": {
          "description": "Its INPUT gets `READ_ONLY` instead of reaching the shell.",
          "type": "boolean"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "AttachmentOpenResult": {
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/Session"
        }
      },
      "required": [
        "attachment",
        "session"
      ],
      "type": "object"
    },
    "AttachmentRef": {
      "description": "Names one attachment: the params of `session.attachment.close`.",
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "attachment"
      ],
      "type": "object"
    },
    "AttachmentResizeParams": {
      "properties": {
        "attachment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "attachment",
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "Blob": {
      "description": "A raw blob: the reply to `fs.read` and `git.show`.",
      "properties": {
        "data": {
          "description": "The bytes, base64 (standard alphabet, padded); absent past `maxBytes`.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size"
      ],
      "type": "object"
    },
    "BpVersion": {
      "properties": {
        "contract": {
          "description": "The version of `bp`'s wire: its requests, responses, envelope and\nprogress events.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "The binary's own version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "contract"
      ],
      "type": "object"
    },
    "Capability": {
      "description": "One module of the daemon and whether this host can serve it; `reason`\nnames the fix when it cannot. `info` is the module's own: `plane`'s is a\n[`PlaneInfo`](crate::plane::PlaneInfo).",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "info": true,
        "module": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "module",
        "available"
      ],
      "type": "object"
    },
    "ClientInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "via": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "DaemonInfo": {
      "description": "`instance` is random per daemon process, so a reconnecting client can\ntell a dropped connection from a restarted daemon.",
      "properties": {
        "instance": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "instance"
      ],
      "type": "object"
    },
    "DaemonShutdownParams": {
      "description": "`restore: false` hangs up every session and forgets it; `true` leaves\nthem for the next daemon instance to restore (ADR 0027).",
      "properties": {
        "restore": {
          "type": "boolean"
        }
      },
      "required": [
        "restore"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "oneOf": [
        {
          "enum": [
            "MODULE_UNAVAILABLE",
            "UNKNOWN_SESSION"
          ],
          "type": "string"
        },
        {
          "const": "HELLO_REQUIRED",
          "description": "The first request on a connection was not `hello`.",
          "type": "string"
        },
        {
          "const": "HELLO_REPEATED",
          "description": "`hello` was already answered on this connection.",
          "type": "string"
        },
        {
          "const": "VERSION_MISMATCH",
          "description": "No protocol version both ends speak; `detail` carries the daemon's range.",
          "type": "string"
        },
        {
          "const": "UNKNOWN_ATTACHMENT",
          "description": "No such attachment on this connection.",
          "type": "string"
        },
        {
          "const": "READ_ONLY",
          "description": "Input on an attachment opened `readOnly`.",
          "type": "string"
        },
        {
          "const": "SESSION_EXITED",
          "description": "Input to a session whose shell has exited.",
          "type": "string"
        },
        {
          "const": "ROOT_GONE",
          "description": "The session root no longer exists.",
          "type": "string"
        },
        {
          "const": "NOT_FOUND",
          "description": "A path the request names does not exist.",
          "type": "string"
        },
        {
          "const": "AGENT_LIVE",
          "description": "`session.open { agent: { resume } }` names an agent session already running or\nresuming in another session.",
          "type": "string"
        },
        {
          "const": "PLANE_EXISTS",
          "description": "`plane.createDraft` names an entry already in the planes directory.",
          "type": "string"
        },
        {
          "const": "BP_REFUSED",
          "description": "`bp` ran and refused; `detail` is its error envelope verbatim.",
          "type": "string"
        },
        {
          "const": "UNKNOWN",
          "description": "Any code this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "ErrorData": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "detail": true
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "FsChanged": {
      "description": "The `fs.changed` event: the watched folder `path` changed, or with\n`gone` it cannot be watched and has left the scope.",
      "properties": {
        "gone": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FsEntry": {
      "properties": {
        "ignored": {
          "description": "Matched by the containing repo's ignore rules, or `.git` and\neverything in it.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/FsEntryKind",
          "description": "What the entry is once symlinks are followed."
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "ignored"
      ],
      "type": "object"
    },
    "FsEntryKind": {
      "oneOf": [
        {
          "enum": [
            "file",
            "directory"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Any kind this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "FsListResult": {
      "properties": {
        "entries": {
          "description": "Sorted by name.",
          "items": {
            "$ref": "#/$defs/FsEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    },
    "FsPathParams": {
      "description": "`fs.list`: a missing path gets `NOT_FOUND`.",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FsReadParams": {
      "description": "`fs.read`: a missing path or a folder gets `NOT_FOUND`.",
      "properties": {
        "maxBytes": {
          "description": "Reply without `data` past this size; capped at [`READ_LIMIT`], its default.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "GitChange": {
      "properties": {
        "from": {
          "description": "The original path of a rename or copy.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/GitChangeKind"
        },
        "path": {
          "description": "Repo-relative.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "type": "object"
    },
    "GitChangeKind": {
      "oneOf": [
        {
          "enum": [
            "modified",
            "typeChanged",
            "added",
            "deleted",
            "renamed",
            "copied",
            "conflicted"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Any kind this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "GitHead": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "branch",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "`sha` is abbreviated to 7 characters.",
          "properties": {
            "kind": {
              "const": "detached",
              "type": "string"
            },
            "sha": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sha"
          ],
          "type": "object"
        },
        {
          "description": "Any head this build does not know, from a newer peer.",
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "GitRepo": {
      "description": "One repo path's state: also the `git.changed` event. Exactly one of\n`status`, `gone` and `error` is set.",
      "properties": {
        "error": {
          "description": "git ran and failed, in its own words.",
          "type": [
            "string",
            "null"
          ]
        },
        "gone": {
          "description": "The path is missing or not a repo; in an event, it left the scope.",
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "GitRev": {
      "oneOf": [
        {
          "enum": [
            "head",
            "index"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Any rev this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "GitShowParams": {
      "description": "`git.show`: `path` is relative to `repo`. A blob missing at `rev`, or a\n`repo` that is not a repo, gets `NOT_FOUND`. Replies with a [`Blob`](crate::fs::Blob).",
      "properties": {
        "maxBytes": {
          "description": "Reply without `data` past this size; capped at [`READ_LIMIT`](crate::fs::READ_LIMIT), its default.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "rev": {
          "$ref": "#/$defs/GitRev"
        }
      },
      "required": [
        "repo",
        "path",
        "rev"
      ],
      "type": "object"
    },
    "GitStatus": {
      "properties": {
        "head": {
          "$ref": "#/$defs/GitHead"
        },
        "staged": {
          "items": {
            "$ref": "#/$defs/GitChange"
          },
          "type": "array"
        },
        "tracking": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitTracking"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent without an upstream, or when the upstream is gone."
        },
        "unstaged": {
          "items": {
            "$ref": "#/$defs/GitChange"
          },
          "type": "array"
        },
        "untracked": {
          "description": "Repo-relative paths.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "head",
        "staged",
        "unstaged",
        "untracked"
      ],
      "type": "object"
    },
    "GitStatusParams": {
      "description": "`git.status`.",
      "properties": {
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    },
    "GitStatusResult": {
      "properties": {
        "repos": {
          "description": "One per requested path, in order.",
          "items": {
            "$ref": "#/$defs/GitRepo"
          },
          "type": "array"
        }
      },
      "required": [
        "repos"
      ],
      "type": "object"
    },
    "GitTracking": {
      "properties": {
        "ahead": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "behind": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ahead",
        "behind"
      ],
      "type": "object"
    },
    "HelloParams": {
      "description": "`protocolVersion` is the newest version the client speaks,\n`minProtocolVersion` the oldest.",
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "minProtocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocolVersion",
        "minProtocolVersion",
        "client"
      ],
      "type": "object"
    },
    "HelloResult": {
      "description": "`protocolVersion` is the version both ends speak from here on.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        },
        "daemon": {
          "$ref": "#/$defs/DaemonInfo"
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocolVersion",
        "daemon",
        "capabilities"
      ],
      "type": "object"
    },
    "Id": {
      "anyOf": [
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "Notification": {
      "properties": {
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "PlaneCreateDraftParams": {
      "description": "`plane.createDraft`: makes `<planesDir>/<id>`, and the planes directory\nif needed. An id `bp` would refuse gets `INVALID_PARAMS`, an existing\nentry `PLANE_EXISTS`. A `plane.changed` follows.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "PlaneDispatchParams": {
      "description": "`plane.dispatch`: one `bp` `Request`, run as `bp --stdin --json`.",
      "properties": {
        "request": true
      },
      "required": [
        "request"
      ],
      "type": "object"
    },
    "PlaneDispatchResult": {
      "description": "`bp`'s `Response`, from an exit of `0` or `3`. Any other exit with an\nerror envelope is `BP_REFUSED`; anything else is an internal error naming\nthe cause.",
      "properties": {
        "response": true
      },
      "required": [
        "response"
      ],
      "type": "object"
    },
    "PlaneInfo": {
      "description": "The `plane` capability's `info` in `hello`: what `bp --version --json`\nanswered at startup.",
      "properties": {
        "bp": {
          "$ref": "#/$defs/BpVersion"
        }
      },
      "required": [
        "bp"
      ],
      "type": "object"
    },
    "PlaneKind": {
      "oneOf": [
        {
          "const": "plane",
          "description": "A directory holding `plane.toml`, as `bp list` reports it.",
          "type": "string"
        },
        {
          "const": "draft",
          "description": "A directory in the planes directory without `plane.toml`.",
          "type": "string"
        },
        {
          "const": "gone",
          "description": "A plane or draft this daemon listed that has since vanished; the only\ngone-plane signal. It stays until the daemon restarts or the id is\nback.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Any kind this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "PlaneListError": {
      "properties": {
        "envelope": {
          "description": "`bp`'s error envelope when it refused, as with `BP_REFUSED`; absent\nwhen `bp` could not be run."
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "PlaneMember": {
      "properties": {
        "member": {
          "description": "`@project` or a repo path, as `bp create` takes it.",
          "type": "string"
        },
        "path": {
          "description": "The member's worktree, absolute: what `git.*` takes.",
          "type": "string"
        }
      },
      "required": [
        "member",
        "path"
      ],
      "type": "object"
    },
    "PlaneProjectsResult": {
      "description": "The reply to `plane.projects`: `bp project list`, sorted by name.",
      "properties": {
        "projects": {
          "items": {
            "$ref": "#/$defs/Project"
          },
          "type": "array"
        }
      },
      "required": [
        "projects"
      ],
      "type": "object"
    },
    "PlaneRow": {
      "description": "One sidebar row.",
      "properties": {
        "directory": {
          "description": "Absolute.",
          "type": "string"
        },
        "findings": {
          "description": "`bp list`'s finding tags, such as `member_worktree_missing`; empty\nunless `kind` is `plane`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "The plane directory's name.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PlaneKind"
        },
        "members": {
          "description": "In plane file order; empty unless `kind` is `plane`.",
          "items": {
            "$ref": "#/$defs/PlaneMember"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "directory",
        "kind",
        "members",
        "findings"
      ],
      "type": "object"
    },
    "PlanesModel": {
      "description": "The reply to `plane.list` and the `plane.changed` event: every plane and\ndraft in the planes directory, sorted by id.",
      "properties": {
        "listError": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaneListError"
            },
            {
              "type": "null"
            }
          ],
          "description": "The last `bp list` failed; `planes` keeps what the one before found."
        },
        "planes": {
          "items": {
            "$ref": "#/$defs/PlaneRow"
          },
          "type": "array"
        },
        "planesDir": {
          "type": "string"
        },
        "planesDirExists": {
          "type": "boolean"
        },
        "refreshedAt": {
          "description": "When `bp list` last answered, in Unix milliseconds; absent until it\nfirst has, and a `plane.changed` follows.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "planesDir",
        "planesDirExists",
        "planes"
      ],
      "type": "object"
    },
    "Project": {
      "properties": {
        "name": {
          "description": "Without the `@`.",
          "type": "string"
        },
        "sourceRepoPresent": {
          "description": "`false` also for a project whose `project.toml` did not parse.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "sourceRepoPresent"
      ],
      "type": "object"
    },
    "Request": {
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "type": "object"
    },
    "Response": {
      "description": "`id` is `null` only when the request it answers could not be read.",
      "oneOf": [
        {
          "properties": {
            "result": true
          },
          "required": [
            "result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "$ref": "#/$defs/RpcError"
            }
          },
          "required": [
            "error"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "type": "string"
        }
      },
      "required": [
        "jsonrpc"
      ],
      "type": "object"
    },
    "RpcError": {
      "description": "A JSON-RPC error. Protocol errors use [`RpcError::SERVER_ERROR`] and name\nthemselves in `data.code`; the numeric codes stay JSON-RPC's own.",
      "properties": {
        "code": {
          "format": "int32",
          "type": "integer"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorData"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Session": {
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionAgent"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set on an agent terminal, whose process is the agent itself, not a shell."
        },
        "attachments": {
          "description": "How many attachments the session has, across all clients.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "foreground": {
          "description": "The name of the terminal's foreground process: the shell when idle,\nabsent while no shell runs.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "description": "The user's name for the session, set by `session.rename`.",
          "type": [
            "string",
            "null"
          ]
        },
        "plane": {
          "description": "Opaque to the daemon: stored, exported as `BITPLANE_PLANE_ID`, returned.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "description": "The session root: the directory the shell starts in.",
          "type": "string"
        },
        "rootGone": {
          "default": false,
          "description": "The root no longer exists; a running shell keeps running, and\n`session.restart` gets `ROOT_GONE` until it is back.",
          "type": "boolean"
        },
        "seq": {
          "description": "Creation order on this host.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "title": {
          "description": "The title the program set (OSC 0/2), kept apart from `name`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "seq",
        "root",
        "status",
        "size",
        "attachments"
      ],
      "type": "object"
    },
    "SessionAgent": {
      "description": "What an agent terminal runs (ADR 0029).",
      "properties": {
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "SessionBusyResult": {
      "description": "The result of `session.busy`: busy when the terminal's foreground process\nis not the shell, and then that process's name.",
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "processName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "busy"
      ],
      "type": "object"
    },
    "SessionListResult": {
      "properties": {
        "sessions": {
          "items": {
            "$ref": "#/$defs/Session"
          },
          "type": "array"
        }
      },
      "required": [
        "sessions"
      ],
      "type": "object"
    },
    "SessionOpenAgent": {
      "description": "The agent an agent terminal launches. `resume` continues that agent\nsession; one live elsewhere gets `AGENT_LIVE`. The agent starts in `cwd`,\nwhich may lie outside the root; without it, a resumed agent session\nstarts where the daemon knows it ran, else in the root. A `cwd` that is\nnot a directory makes the session `spawnFailed`.",
      "properties": {
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "resume": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "SessionOpenParams": {
      "description": "`session.open`: `root` must be an existing directory. `env` is set on top\nof the daemon's login-shell environment. Without `agent` the session is a\nregular terminal running the login shell; with it, an agent terminal.",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionOpenAgent"
            },
            {
              "type": "null"
            }
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "plane": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "SessionRef": {
      "description": "Names one session: the params of `session.close`, `session.restart` and\n`session.busy`, and the `session.removed` event.",
      "properties": {
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ],
      "type": "object"
    },
    "SessionRenameParams": {
      "description": "`session.rename`: no `name` clears it. Replies with [`SessionResult`].",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ],
      "type": "object"
    },
    "SessionResult": {
      "description": "The result of `session.open`, and the `session.changed` event.",
      "properties": {
        "session": {
          "$ref": "#/$defs/Session"
        }
      },
      "required": [
        "session"
      ],
      "type": "object"
    },
    "SessionStatus": {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "running",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "format": "int32",
              "type": "integer"
            },
            "state": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "state",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The shell could not be started.",
          "properties": {
            "error": {
              "type": "string"
            },
            "state": {
              "const": "spawnFailed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "error"
          ],
          "type": "object"
        },
        {
          "description": "Any state this build does not know, from a newer peer.",
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Size": {
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "Tracking": {
      "description": "Where the agent's state comes from: its hooks, or only the polled\n`claude agents --json` registry when the hooks did not load.",
      "oneOf": [
        {
          "enum": [
            "hooks",
            "poll"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Any mode this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "WaitingReason": {
      "oneOf": [
        {
          "enum": [
            "permission",
            "input",
            "other"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Any reason this build does not know, from a newer peer.",
          "type": "string"
        }
      ]
    },
    "WatchParams": {
      "description": "`fs.watch` and `git.watch`: replaces this connection's scope of the\nmodule; `[]` stops. Only paths new to the scope get an initial event.",
      "properties": {
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bitplane protocol"
}
